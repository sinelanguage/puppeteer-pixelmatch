{
  "name": "pixeldiff-automation",
  "version": "2.0.0",
  "description": "TypeScript visual diff automation with Puppeteer",
  "type": "module",
  "main": "./build/main.js",
  "scripts": {
    "compile": "tsc",
    "clean": "rm -rf build screenshots-current screenshots-originals",
    "snap:baseline": "npm run compile && node build/baseline-runner.js",
    "snap:verify": "npm run compile && node build/verify-runner.js",
    "verify": "npm run compile && mocha build/**/*.test.js"
  },
  "keywords": [
    "puppeteer",
    "visual-diff",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4",
    "pixelmatch": "^7.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^23.10.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "chai": "^5.1.2",
    "mocha": "^11.7.5",
    "typescript": "^5.7.2"
  }
}
